# Copia este fichero a .env y ajusta los valores antes de "docker compose up".

# Contraseñas de MariaDB (obligatorias, elige las tuyas)
DB_PASSWORD=cambia-esta-contrasena
DB_ROOT_PASSWORD=cambia-esta-tambien

# Clave secreta de la app (firma de cookies de sesión, hashes). Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-secreta

# URL pública donde se sirve la app (sin barra final). Se usa en los enlaces
# de los correos de verificación/recuperación de contraseña.
APP_URL=http://localhost:8000

# Puerto en el host donde se expone la app
APP_PORT=8000

# SMTP opcional: si se deja vacío, el registro de usuarios funciona sin
# verificación por email (no podrás enviar el correo de recuperación de
# contraseña sin esto configurado).
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=DockerLabs
SMTP_FROM=

# Discord opcional: notifica nuevas máquinas/writeups a un webhook.
DISCORD_WEBHOOK_URL=
DISCORD_NEWS_ROLE_ID=
